FROM docker.io/library/python:3.11-slim

ARG APP_VERSION=dev
LABEL org.opencontainers.image.title="due-diligence-assistant" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.description="尽调报告助手行内离线部署镜像"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONNOUSERSITE=1 \
    DATA_DIR=/app/data

WORKDIR /app

COPY deploy/docker/requirements-intranet.txt /opt/requirements-intranet.txt
COPY deploy/docker/wheelhouse /opt/wheelhouse
RUN python -m pip install \
      --no-index \
      --find-links=/opt/wheelhouse \
      --requirement /opt/requirements-intranet.txt \
    && python -c "import fastapi,cryptography,httpx,pydantic,pymysql,dotenv,uvicorn" \
    && rm -rf /opt/wheelhouse /opt/requirements-intranet.txt /root/.cache

COPY app /app/app
COPY data /app/data
COPY frontend/dist /app/frontend/dist

RUN groupadd --gid 10001 app \
    && useradd --uid 10001 --gid app --no-create-home --shell /usr/sbin/nologin app

USER 10001:10001

EXPOSE 8720

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8720/api/v1/health/live', timeout=3)"]

CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8720"]
