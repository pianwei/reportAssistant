COMPOSE_PROJECT_NAME=due-diligence-assistant
CONTAINER_CLI=nerdctl
CONTAINER_NAMESPACE=k8s.io

APP_IMAGE=docker.io/library/due-diligence-assistant:20260817-mysql-ops-v2
APP_IMAGE_ARCHIVE=images/due-diligence-assistant-20260817-mysql-ops-v2.image.tar
APP_CONTAINER_NAME=due-diligence-assistant
APP_PORT=8888
APP_ENV_FILE=.env.intranet

MYSQL_IMAGE=docker.io/library/mysql:8.4
MYSQL_IMAGE_ARCHIVE=images/mysql-8.4.image.tar
MYSQL_CONTAINER_NAME=due-diligence-mysql
MYSQL_DATABASE=due_diligence
MYSQL_USER=due_diligence
MYSQL_PASSWORD=replace-with-strong-password
MYSQL_ROOT_PASSWORD=replace-with-separate-root-password

TZ=Asia/Shanghai
REQUIRE_EMPTY_DATABASE_VOLUME=true
EXPECTED_REPORTS=293
EXPECTED_REPORT_TAGS=5860
EXPECTED_SESSIONS=2
EXPECTED_MESSAGES=4
EXPECTED_SESSION_TAGS=2
EXPECTED_SUGGESTION_BATCHES=6
EXPECTED_MODEL_PROFILES=0
EXPECTED_MODEL_EVENTS=0
